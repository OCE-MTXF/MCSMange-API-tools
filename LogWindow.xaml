<Window x:Class="MCSMServerManager.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/MCSMServerManager;component/ico.ico"
        Title="实例日志 - MCSM 服务器管理器 by OCE_MTXF BUG联系oce_mtxf@outlook.com" Height="620" Width="900"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="TitleText" Style="{StaticResource H2}" Margin="0,0,0,10" />
        <TextBox Grid.Row="1" x:Name="LogBox" IsReadOnly="True"
                 AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="复制全部" Style="{StaticResource GhostButton}" Click="CopyButton_Click" />
            <Button Content="关闭" Margin="8,0,0,0" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
