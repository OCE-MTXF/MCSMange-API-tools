<Window x:Class="MCSMServerManager.NodeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/MCSMServerManager;component/ico.ico"
        Title="添加节点 - MCSM 服务器管理器 by OCE_MTXF BUG联系oce_mtxf@outlook.com"
        Height="380" Width="520" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="IP / 域名" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox Grid.Column="1" x:Name="IpBox" Text="127.0.0.1" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="端口" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox Grid.Column="1" x:Name="PortBox" Text="24444" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="备注" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox Grid.Column="1" x:Name="RemarksBox" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="前缀" VerticalAlignment="Center" Margin="0,0,10,0"
                       ToolTip="可选。守护进程在该前缀下的实例会暴露给面板。" />
            <TextBox Grid.Column="1" x:Name="PrefixBox" />
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="节点密钥" VerticalAlignment="Center" Margin="0,0,10,0"
                       ToolTip="守护进程 daemon 配置文件中的 ipc 密码。" />
            <PasswordBox Grid.Column="1" x:Name="ApiKeyBox" />
        </Grid>

        <TextBlock Grid.Row="5" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="添加后请在节点列表点击「连接节点」完成握手，握手成功后该节点才会显示为在线。" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="添加" IsDefault="True" Click="OkButton_Click" />
            <Button Content="取消" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                    IsCancel="True" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>