<Window x:Class="MCSMServerManager.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/MCSMServerManager;component/ico.ico"
        Title="关于 - MCSM 服务器管理器 by OCE_MTXF BUG联系oce_mtxf@outlook.com"
        Height="660" Width="720" MinHeight="480" MinWidth="620"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <Border Width="56" Height="56" CornerRadius="12" Background="{StaticResource AccentBrush}">
                <Image Source="/MCSMServerManager;component/ico.ico" Width="36" Height="36" />
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource H1}" />
                <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="关于本软件" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="MCSM 服务器管理器是一个基于 MCSManager 官方 HTTP API 的 Windows 桌面客户端，用于管理 Minecraft、Paper、Folia 等游戏服务器实例。" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" Text="本软件为第三方客户端，与 MCSManager 官方无隶属关系。" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0">
                            <Run Text="作者与联系方式：" /><Run Text="OCE_MTXF" Foreground="{StaticResource TextBrush}" /><Run Text="（oce_mtxf@outlook.com）" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="开源协议" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="本软件基于 MCSManager 的公开接口开发。MCSManager 采用 Apache License 2.0，本软件同样以 Apache License 2.0 发布。" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Apache-2.0 允许自由使用、修改与再分发，要求保留版权声明与许可证全文，并对改动作出说明。" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                   Text="完整许可证文本见安装目录中的 LICENSE 文件。" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="打开 LICENSE 文件" Style="{StaticResource GhostButton}" Click="OpenLicenseButton_Click" />
                            <Button Content="复制许可证信息" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="CopyLicenseButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="鸣谢" Margin="0,0,0,10" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6">
                            <Run Text="· " /><Run Text="MCSManager" Foreground="{StaticResource TextBrush}" /><Run Text=" —— 提供了本软件所依赖的全部接口与文档，Apache-2.0 协议，作者为 MCSManager 开发团队。" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6">
                            <Run Text="· " /><Run Text=".NET 9 / WPF" Foreground="{StaticResource TextBrush}" /><Run Text=" —— 界面框架与运行时，MIT 协议，© Microsoft Corporation。" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6">
                            <Run Text="· " /><Run Text="界面参考" Foreground="{StaticResource TextBrush}" /><Run Text=" —— 布局与交互参考了 MCSManager 网页版面板。" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6">
                            <Run Text="· " /><Run Text="PCL（Plain Craft Launcher）" Foreground="{StaticResource TextBrush}" /><Run Text=" —— 可展开的错误弹窗交互思路参考自 PCL。PCL 由成都瓜皮龙科技有限公司（Meloong）以《PCL 分发有限许可》发布，该许可并非开源许可。" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0">
                            <Run Text="关于 PCL 的许可说明：" /><Run Text="依《PCL 存储库合理使用指南》，本软件属于轻度使用——仅参考了极小部分内容，且本软件的实质功能（通过 MCSManager 接口管理游戏服务器）与 PCL 的实质功能（启动 Minecraft）不存在重叠。轻度使用要求：其一，以适当形式署名，即本处对 PCL 的致谢；其二，不得将本软件与 PCL 混淆或暗示关联，故本软件不使用 PCL 的任何名称、图标或品牌标识，也不是 PCL 的分支、魔改或二次创作产物。若日后被认定构成重度使用，将优先履行该类别义务（含必须以 Plain Craft Launcher (PCL) 开头命名等要求）。" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="关闭" IsDefault="True" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>