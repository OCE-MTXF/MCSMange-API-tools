<Window x:Class="MCSMServerManager.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/MCSMServerManager;component/ico.ico"
        Title="输入 - MCSM 服务器管理器 by OCE_MTXF BUG联系oce_mtxf@outlook.com" Height="190" Width="440" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="PromptText" Style="{StaticResource Muted}"
                   Margin="0,0,0,8" TextWrapping="Wrap" />
        <TextBox Grid.Row="1" x:Name="InputBox" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="确定" IsDefault="True" Click="OkButton_Click" />
            <Button Content="取消" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                    IsCancel="True" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>