<Window x:Class="MCSMServerManager.DetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/MCSMServerManager;component/ico.ico"
        Title="出错了 - MCSM 服务器管理器 by OCE_MTXF BUG联系oce_mtxf@outlook.com"
        Height="560" Width="760" MinHeight="320" MinWidth="560"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Border x:Name="IconBadge" Width="40" Height="40" CornerRadius="20"
                    Background="{StaticResource DangerBrush}" VerticalAlignment="Top">
                <TextBlock x:Name="IconGlyph" Text="&#xE783;" FontFamily="Segoe MDL2 Assets"
                           FontSize="18" Foreground="White" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="HeadlineText" Style="{StaticResource H2}" TextWrapping="Wrap" />
                <TextBlock x:Name="SublineText" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <Expander Grid.Row="1" x:Name="DetailExpander" Header="查看详细信息" Margin="0,16,0,0"
                  IsExpanded="False">
            <Border Margin="0,10,0,0" Padding="12" CornerRadius="6"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="MetaText" Style="{StaticResource Muted}"
                               Margin="0,0,0,8" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                    <TextBox Grid.Row="1" x:Name="BodyBox" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" />
                </Grid>
            </Border>
        </Expander>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CopyDetailButton" Content="复制详情" Style="{StaticResource GhostButton}"
                    Click="CopyDetailButton_Click" />
            <Button Content="打开日志" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                    Click="OpenLogButton_Click" />
            <Button Content="知道了" Margin="8,0,0,0" IsDefault="True" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>